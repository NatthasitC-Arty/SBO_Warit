INNER JOIN DPI10 ON ODPI.DocEntry = DPI10.DocEntry
LEFT JOIN DPI1 ON DPI10.DocEntry = DPI1.DocEntry AND DPI10.AftLineNum = DPI1.LineNum
-- ใช้ OUTER APPLY ดึง Project แรกที่เจอใน Line มาใช้งาน
