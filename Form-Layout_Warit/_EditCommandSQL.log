        FROM DPI1 L WHERE L.DocEntry = ODPI.DocEntry
        AND L.TreeType NOT IN ('I', 'i')
        AND NOT (ISNULL(L.TreeType, 'N') = 'N' AND EXISTS (SELECT 1 FROM ITT1 WHERE Code = L.ItemCode AND Father = (SELECT TOP 1 P.ItemCode FROM DPI1 P WHERE P.DocEntry = L.DocEntry AND P.VisOrder < L.VisOrder AND (P.TreeType IN ('S', 'A', 'T') OR EXISTS (SELECT 1 FROM OITT WHERE Code = P.ItemCode)) ORDER BY P.VisOrder DESC)))
    ) AS 'Sum_LineTotal_All',

    
    ODPI.dpmprcnt,

    RCT1.CheckNum,

    RCT1.[CheckSum],

    RCT1.DueDate AS 'Check Date',

    
    -- ใช้ SUM() OVER() แทน GROUP BY สำหรับยอด Cash และ Transfer
    SUM(ORCT.CashSum) OVER(PARTITION BY ODPI.DocEntry) AS 'CashSum',

    SUM(ORCT.TrsfrSum) OVER(PARTITION BY ODPI.DocEntry) AS 'TrsfrSum',

    
    ODSC.BankName,
    'T' AS 'LineType',

    OSLP.U_Name_Foreign AS 'Name',

