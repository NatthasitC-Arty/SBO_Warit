        WHEN ODPI.Printed = 'N' AND ODPI.DocCur = OADM.MainCurncy THEN N'ต้นฉบับ'
        WHEN ODPI.Printed = 'Y' AND ODPI.DocCur <> OADM.MainCurncy THEN 'Copy'
