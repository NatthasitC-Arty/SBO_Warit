LEFT JOIN CRD1 ON (OCRD.CardCode = CRD1.CardCode AND ODPI.PayToCode = CRD1.[Address] AND CRD1.AdresType ='B')
LEFT JOIN OCRY ON CRD1.Country = OCRY.Code
LEFT JOIN OSLP ON ODPI.SlpCode = OSLP.SlpCode 
